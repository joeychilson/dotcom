<ascii-sea class="sea-component">
  <figure class="sailboat">
    <div class="sailboat-drift">
      <canvas
        width="540"
        height="480"
        role="img"
        aria-label="An ASCII sailboat floating on shimmering water"></canvas>
    </div>
    <button
      class="motion-control"
      hidden
      data-pause
      aria-pressed="false"
      aria-label="Pause sailboat animation"
      type="button"
    >
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path data-pause-icon d="M4 3h3v10H4zm5 0h3v10H9z"></path>
        <path data-play d="m5 2 9 6-9 6z"></path>
      </svg>
    </button>
    <noscript
      ><p class="no-script-art" role="img" aria-label="A sailboat on the water">
        &nbsp;&nbsp;/|<br />&nbsp;/_|\<br />\____/<br />~ ~ ~ ~
      </p><style>
        ascii-sea canvas,
        ascii-sea button {
          display: none;
        }
      </style></noscript
    >
  </figure>
</ascii-sea>
<script>
  import { mountSea } from '../scripts/sea';
  class AsciiSea extends HTMLElement {
    cleanup?: () => void;
    connectedCallback() {
      this.cleanup = mountSea(this);
    }
    disconnectedCallback() {
      this.cleanup?.();
    }
  }
  if (!customElements.get('ascii-sea'))
    customElements.define('ascii-sea', AsciiSea);
</script>
