---
import Base from '../layouts/Base.astro';
import Skyline from '../components/Skyline.astro';
---

<Base
  title="Page not found"
  description="A little off course. Let’s get you back home."
  noindex
>
  <main id="main" class="lost-page">
    <div class="error-scene reveal arrival-art">
      <Skyline />
    </div>
    <div class="lost-copy reveal arrival-intro">
      <h1>A little off course.</h1>
      <p>There’s no page on this block.<br />Let’s find your way home.</p>
      <a class="homeward" href="/"
        ><span aria-hidden="true">←</span> Back home</a
      >
    </div>
  </main>
</Base>
